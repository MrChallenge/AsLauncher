<UserControl x:Class="AsLauncher.Views.Components.MinecraftVersionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:AsLauncher.Resources.Localization"
             xmlns:core="clr-namespace:AsLauncher.Core"
             xmlns:components="clr-namespace:AsLauncher.Views.Components"
             xmlns:models="clr-namespace:AsLauncher.Models">

    <Border Background="{x:Static core:Theme.Middleground}"
            CornerRadius="12"
            Margin="0,0,0,6"
            Padding="8">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- Version type indicator -->
            <Ellipse x:Name="VersionTypeIndicator"
                     Width="10"
                     Height="10"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"/>

            <!-- Version number -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Version.Id, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{x:Static core:Theme.White}"
                       FontSize="14"
                       VerticalAlignment="Center">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="FontWeight" Value="Normal"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Version.Type, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="release">

                                <Setter Property="FontWeight" Value="SemiBold"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </TextBlock.Style>

            </TextBlock>

            <Grid Grid.Column="2" Margin="-120,0,0,0">

                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="34"/>
                    
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="300"
                      Height="26"
                      Margin="0,0,10,0">

                    <!-- Download -->
                    <ProgressBar Margin="0,10,0,0"
                                 Height="6"
                                 VerticalAlignment="Top"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Version.DownloadProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Visibility="{Binding Version.IsDownloadProgressVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{x:Static core:Theme.LightBlue}"
                                 Style="{StaticResource ModernProgressBar}"/>

                    <!-- Setup -->
                    <ProgressBar Margin="0,10,0,0"
                                 Height="6"
                                 VerticalAlignment="Top"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Version.SetupProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Visibility="{Binding Version.IsSetupProgressVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{x:Static core:Theme.LightGreen}"
                                 Style="{StaticResource ModernProgressBar}"/>

                    <!-- Setup Status -->
                    <TextBlock Margin="0,0,0,-4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               FontSize="10"
                               Foreground="{x:Static core:Theme.LightGrey}"
                               Text="{Binding Version.SetupStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Visibility="{Binding Version.IsSetupProgressVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                </Grid>

                <!-- Main Button -->
                <components:ActionButton Grid.Column="1"
                                         x:Name="MinecraftVersionMainButton"
                                         Click="MinecraftVersionButton_Click"
                                         Width="86"
                                         Height="28"
                                         ButtonContent="{x:Static lang:Resources.ButtonInstall}"/>

                <!-- Delete Button -->
                <components:ActionButton Grid.Column="2"
                                         x:Name="MinecraftVersionRemoveButton"
                                         Click="RemoveButton_Click"
                                         Width="28"
                                         Height="28"
                                         Margin="6,0,0,0"
                                         Visibility="Collapsed"
                                         ButtonBackground="{x:Static core:Theme.Red}">

                    <components:ActionButton.ButtonContent>

                        <Image Source="{x:Static core:Theme.RemoveButton}"
                               Width="14"
                               Height="14"
                               Stretch="Uniform"/>

                    </components:ActionButton.ButtonContent>

                </components:ActionButton>

            </Grid>

        </Grid>

    </Border>

</UserControl>